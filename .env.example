# =============================================================================
# INVENTO APP — Variables de entorno
# Copia este archivo a .env y ajusta los valores.
# En producción con Docker, inyecta estas variables vía el orquestador
# (docker run -e, docker-compose env_file, Kubernetes secrets, etc.).
# NUNCA incluyas el .env real en la imagen Docker (.dockerignore lo excluye).
# =============================================================================

# -----------------------------------------------------------------------------
# PUERTOS
# Backend Express escucha en PORT. Debe coincidir con VITE_PROXY_PORT (dev).
# En contenedor: PORT debe coincidir con el EXPOSE del dockerfile.backend (3001).
# -----------------------------------------------------------------------------
PORT=3001
VITE_PROXY_PORT=3001

# -----------------------------------------------------------------------------
# APIs de IA (obligatorias para Levantamiento y Etiquetado)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_KEY=
GEMINI_API_KEY=

# Servicio productivo de etiquetado. Invento solo envía la muestra configurada.
MULTITAG_API_URL=
# Opcional: preparado para despliegues que protejan multitag-api con Bearer token.
MULTITAG_API_TOKEN=
# Límites de costo y presión sobre el servicio productivo.
MULTITAG_MAX_SAMPLE=200
MULTITAG_CONCURRENCY=5
MULTITAG_TIMEOUT_MS=120000

# Servicio de análisis de sentimiento (sentiment-model, FastAPI + pysentimiento).
SENTIMENT_API_URL=
# Textos por request a /predict/batch y llamadas concurrentes a sentiment-model.
SENTIMENT_BATCH_SIZE=150
SENTIMENT_CONCURRENCY=3
SENTIMENT_TIMEOUT_MS=60000

# Servicio de reporte PDF OTBB (otbb-service, FastAPI + Claude + Gotenberg).
OTBB_SERVICE_URL=
OTBB_SERVICE_TIMEOUT_MS=60000

# motor-exclusiones (FastAPI, marca ruido operativo antes del threading OTBB).
# Local con docker compose: ver motor-exclusiones/compose.yaml (puerto 8095,
# no 8000 — ya lo usa otbb-service en local). La API key es la que trae
# C:/motor-exclusiones/secrets/api_key.txt (o el secret que se haya montado).
MOTOR_EXCLUSIONES_URL=http://localhost:8095
MOTOR_EXCLUSIONES_API_KEY=
MOTOR_EXCLUSIONES_TIMEOUT_MS=90000

# Modelo Claude (opcional — por defecto: claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5
# Modelo Gemini para el segundo juez de AutoQA (opcional — por defecto: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# Seguridad / API
# -----------------------------------------------------------------------------
# En producción, lista separada por comas. En desarrollo se permite cualquier origen.
# ALLOWED_ORIGINS=https://tu-dominio.com,https://otro-dominio.com
# Límite de body Express (por defecto: 50mb)
# BODY_LIMIT=50mb

# -----------------------------------------------------------------------------
# Catálogo experto RAG (embeddings para /api/catalog/*)
# Requiere OPENAI_KEY. El índice se cachea en .cache/catalog_embeddings.json.
# -----------------------------------------------------------------------------
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Azure Storage File Share (obligatorio para AutoQA)
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SHARE_NAME=

# -----------------------------------------------------------------------------
# Login (obligatorio — sin esto /login responde error 500)
# -----------------------------------------------------------------------------
LOGIN_USER=
LOGIN_PASSWORD=

# -----------------------------------------------------------------------------
# Datadog APM (recomendado en producción; dd-trace se carga en el contenedor)
# -----------------------------------------------------------------------------
DD_SERVICE=invento-app
DD_ENV=production
DD_VERSION=1.0.0
DD_AGENT_HOST=datadog-agent
DD_TRACE_AGENT_PORT=8126
